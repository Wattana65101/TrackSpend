# Database
DB_HOST=localhost
DB_PORT=3308
DB_USER=trackspend_user
DB_PASSWORD=trackspend_pass
DB_NAME=trackspend

# Server
SERVER_PORT=500
JWT_SECRET_KEY=your_very_secret_key_change_this_in_production

# ส่งอีเมลรหัสยืนยัน - ใช้อย่างใดอย่างหนึ่ง (Gmail หรือ Resend)

# ตัวเลือก 1: Gmail (ฟรี ไม่ต้องสมัครบริการอื่น)
# เปิด 2-Step Verification แล้วสร้าง App Password ที่ https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ตัวเลือก 2: Resend (ฟรี 3,000 อีเมล/เดือน)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=TrackSpend <onboarding@resend.dev>

# CORS
ALLOWED_ORIGINS=*
